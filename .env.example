# Copy to .env and fill in ONE of these. .env is gitignored; keys are only read server-side.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Optional: force a provider (elevenlabs | openai). Default: whichever key is set, ElevenLabs first.
TRANSCRIBE_PROVIDER=

# Optional
PORT=3030

# Optional: bind address (default 127.0.0.1, local only)
HOST=
